// Prisma Schema for AI Outreach Pro
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  name         String
  role         String            @default("ADMIN") // ADMIN, OPERATOR
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  approvals    MessageApproval[]
  auditLogs    AuditLog[]
}

model Lead {
  id                    String              @id @default(cuid())
  leadId                String              @unique // Business/external lead ID
  companyName           String
  contactName           String
  businessType          String?
  email                 String              @unique
  phone                 String?
  website               String?
  location              String?
  existingWebsiteStatus String?             // None, Outdated, Broken, Modern, Redesign Needed
  serviceInterest       String?             // Website development, Android application development, etc.
  emailPermission       Boolean             @default(false)
  whatsappOptIn         Boolean             @default(false)
  consentSource         String?             // Form, Inbound, Opt-in Sheet
  consentTimestamp      DateTime?
  notes                 String?
  status                String              @default("NEW") // NEW, DRAFTED, CONTACTED, REPLIED, INTERESTED, MEETING_REQUESTED, NOT_INTERESTED, UNSUBSCRIBED, CLOSED
  emailStatus           String              @default("ACTIVE") // ACTIVE, BOUNCED, UNSUBSCRIBED, COMPLAINED
  whatsappStatus        String              @default("ACTIVE") // ACTIVE, OPTED_OUT, FAILED
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  consentRecords        ConsentRecord[]
  campaignRecipients    CampaignRecipient[]
  generatedMessages     GeneratedMessage[]
  conversations         Conversation[]
  followUps             FollowUp[]

  @@index([status])
  @@index([email])
  @@index([phone])
}

model ConsentRecord {
  id           String    @id @default(cuid())
  leadId       String
  channel      String    // EMAIL, WHATSAPP
  consentGiven Boolean   @default(false)
  consentSource String?
  ipAddress    String?
  userAgent    String?
  evidence     String?
  timestamp    DateTime  @default(now())

  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([channel])
}

model Campaign {
  id                   String              @id @default(cuid())
  name                 String
  targetAudience       String?
  serviceOffered       String              // Web Development, Android Apps, Redesign, etc.
  communicationChannel String              @default("EMAIL") // EMAIL, WHATSAPP, BOTH
  schedule             String?             // Cron expression or descriptive schedule
  status               String              @default("DRAFT") // DRAFT, SCHEDULED, ACTIVE, PAUSED, COMPLETED, CANCELLED
  dailySendingCap      Int                 @default(10)
  approvalMode         String              @default("MANUAL") // MANUAL, AUTO
  followUpPolicy       String?             // e.g. JSON {"steps": [{"day": 4}, {"day": 9}]}
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  recipients           CampaignRecipient[]
  generatedMessages    GeneratedMessage[]
  followUps            FollowUp[]
}

model CampaignRecipient {
  id           String    @id @default(cuid())
  campaignId   String
  leadId       String
  status       String    @default("PENDING") // PENDING, APPROVED, SENT, FAILED, SKIPPED, REPLIED, OPTED_OUT
  stepNumber   Int       @default(0) // 0 = initial outreach, 1 = follow up 1, etc.
  scheduledAt  DateTime?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId, stepNumber])
  @@index([campaignId])
  @@index([leadId])
}

model GeneratedMessage {
  id                        String           @id @default(cuid())
  campaignId                String?
  leadId                    String
  channel                   String           @default("EMAIL") // EMAIL, WHATSAPP
  subject                   String
  emailBody                 String
  whatsappTemplateName      String?
  whatsappTemplateVariables String?          // JSON encoded dictionary
  suggestedService          String
  personalizationReason     String
  confidenceScore           Float            @default(0.0)
  followUpEmail             String?
  status                    String           @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, SENT, FAILED
  generatedByModel          String           @default("openrouter/free")
  retryCount                Int              @default(0)
  errorMessage              String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  lead                      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign                  Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  approvals                 MessageApproval[]
  sendJobs                  SendJob[]

  @@index([leadId])
  @@index([status])
  @@index([campaignId])
}

model MessageApproval {
  id                 String           @id @default(cuid())
  generatedMessageId String
  reviewerUserId     String?
  decision           String           // APPROVED, REJECTED, MODIFIED
  modifiedSubject    String?
  modifiedBody       String?
  reviewNotes        String?
  reviewedAt         DateTime         @default(now())

  generatedMessage   GeneratedMessage @relation(fields: [generatedMessageId], references: [id], onDelete: Cascade)
  reviewer           User?            @relation(fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@index([generatedMessageId])
}

model SendJob {
  id                 String           @id @default(cuid())
  generatedMessageId String
  channel            String           // EMAIL, WHATSAPP
  scheduledFor       DateTime         @default(now())
  lockedAt           DateTime?
  lockedBy           String?
  status             String           @default("QUEUED") // QUEUED, PROCESSING, SENT, FAILED, CANCELLED
  idempotencyKey     String           @unique
  attempts           Int              @default(0)
  maxAttempts        Int              @default(3)
  lastError          String?
  sentAt             DateTime?
  createdAt          DateTime         @default(now())

  generatedMessage   GeneratedMessage @relation(fields: [generatedMessageId], references: [id], onDelete: Cascade)
  deliveryEvents     DeliveryEvent[]

  @@index([status])
  @@index([scheduledFor])
}

model DeliveryEvent {
  id                String    @id @default(cuid())
  sendJobId         String
  channel           String    // EMAIL, WHATSAPP
  eventType         String    // ACCEPTED, DELIVERED, READ, BOUNCED, FAILED, SPAM_COMPLAINT, OPT_OUT
  providerMessageId String?
  rawPayload        String?   // JSON representation
  timestamp         DateTime  @default(now())

  sendJob           SendJob   @relation(fields: [sendJobId], references: [id], onDelete: Cascade)

  @@index([sendJobId])
  @@index([eventType])
}

model Conversation {
  id            String                @id @default(cuid())
  leadId        String
  channel       String                @default("EMAIL") // EMAIL, WHATSAPP
  threadId      String?               // Gmail threadId or WhatsApp sender phone ID
  subject       String?
  status        String                @default("OPEN") // OPEN, REPLIED, RESOLVED, CLOSED
  lastMessageAt DateTime              @default(now())
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  lead          Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages      ConversationMessage[]

  @@unique([leadId, channel])
  @@index([leadId])
  @@index([threadId])
}

model ConversationMessage {
  id                String       @id @default(cuid())
  conversationId    String
  direction         String       // INBOUND, OUTBOUND
  sender            String
  recipient         String
  subject           String?
  content           String
  providerMessageId String?
  timestamp         DateTime     @default(now())

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model FollowUp {
  id              String    @id @default(cuid())
  campaignId      String?
  leadId          String
  parentMessageId String?
  stepNumber      Int       // 1 for 1st follow up (Day 4), 2 for 2nd follow up (Day 9), etc.
  delayDays       Int       @default(4)
  scheduledFor    DateTime
  status          String    @default("SCHEDULED") // SCHEDULED, CANCELLED_REPLY, CANCELLED_OPTOUT, CANCELLED_STATUS, EXECUTED, SKIPPED
  subject         String
  body            String
  channel         String    @default("EMAIL") // EMAIL, WHATSAPP
  createdAt       DateTime  @default(now())

  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([status])
  @@index([scheduledFor])
}

model Integration {
  id              String    @id @default(cuid())
  provider        String    @unique // GOOGLE_OAUTH, WHATSAPP_CLOUD, OPENROUTER, OLLAMA
  status          String    @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ERROR
  configEncrypted String?   // Encrypted JSON with secrets / refresh tokens
  expiresAt       DateTime?
  lastSyncAt      DateTime?
  errorLog        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AIUsage {
  id               String   @id @default(cuid())
  provider         String   // OPENROUTER, OLLAMA
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCost    Float    @default(0.0) // 0.0 for free tier models
  durationMs       Int      @default(0)
  requestType      String   // DRAFT_GENERATION, RETRY, TEST
  timestamp        DateTime @default(now())

  @@index([provider])
  @@index([timestamp])
}

model SuppressionList {
  id         String   @id @default(cuid())
  identifier String   @unique // Email or E.164 phone number
  channel    String   @default("ALL") // EMAIL, WHATSAPP, ALL
  reason     String   // OPT_OUT, BOUNCE, COMPLAINT, MANUAL_BLOCK
  notes      String?
  addedAt    DateTime @default(now())

  @@index([identifier])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // CREATE_LEAD, APPROVE_MESSAGE, SEND_EMAIL, SYNC_SHEETS, OPT_OUT, etc.
  entityType String   // Lead, Message, Campaign, Setting
  entityId   String?
  details    String?  // Sanitized JSON details
  ipAddress  String?
  timestamp  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([timestamp])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
