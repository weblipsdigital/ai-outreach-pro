# ==============================================================================
# AI Outreach Pro - Environment Configuration
# ==============================================================================

# Application & Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (Prisma SQLite)
DATABASE_URL="file:./dev.db"

# Security & Authentication
JWT_SECRET=outreach_super_secret_jwt_token_change_in_production
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32-byte hex for AES-256
ADMIN_EMAIL=admin@aioutreachpro.local
ADMIN_PASSWORD=Admin@Outreach2026!

# Agency Profile
AGENCY_NAME="Apex Digital Studio"
AGENCY_EMAIL="outreach@apexdigital.example"
AGENCY_WEBSITE="https://apexdigital.example"
AGENCY_SERVICES="Website development, Business website redesign, E-commerce website development, Android application development, Custom web application development, Website maintenance"

# AI Configuration (Free Models by Default)
# OpenRouter Free tier model: e.g. openrouter/free or meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local Ollama Fallback (100% Free & Offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Google APIs (Sheets & Gmail)
# Create in Google Cloud Console with Gmail API & Google Sheets API enabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback

# WhatsApp Business Cloud API (Official Meta API - Optional)
# Never uses unofficial or browser-based WhatsApp automation
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=ai_outreach_wh_verify_secret_token
WHATSAPP_APP_SECRET=
WHATSAPP_HARD_SPEND_LIMIT=0.00

# Automation Defaults & Safety Rails
# Strict default: sending disabled, dry run enabled, manual approval required
DRY_RUN=true
AUTO_APPROVE=false
AUTO_SEND=false
WHATSAPP_SEND_ENABLED=false
PAID_SERVICES_ENABLED=false
DAILY_EMAIL_LIMIT=10
DAILY_WHATSAPP_LIMIT=10
DEFAULT_TIMEZONE=Asia/Kolkata
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
